+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Fused Q2_K dequant + dot GEMM (Triton) -- Step 4c de-risking slice.
+
+This completes the MoE W2 (DOWN) proof for the IQ2_XXS/Q2_K -> Ada (sm_89)
+native-decode port.  It is the sibling of Step 4b (``iq2_xxs_mm_triton.py``):
+a STANDALONE fused kernel that computes the MoE DOWN-projection matmul
+
+    C[M, N] = A[M, K] (bf16 activations) @ W[N, K]^T   (W stored as Q2_K)
+
+directly from the raw Q2_K block bytes, *without* materializing the
+dequantized weight matrix.  After Step 4c BOTH MoE GEMMs are proven:
+
+    * gate/up (IQ2_XXS, 66 B / 256 elems) -- Step 4b
+    * down    (Q2_K,     84 B / 256 elems) -- this file
+
+Q2_K block layout (84 B per 256 elements; matches
+``iq2_xxs_ref.dequant_q2_k_block`` which mirrors antirez ``ds4_cuda.cu`` lines
+17239-17261 verbatim)::
+
+    uint8_t  scales[16]  bytes 0..15    (per-sub-block: low nibble = 4-bit
+                                         scale, high nibble = 4-bit min)
+    uint8_t  qs[64]      bytes 16..79   (256 x 2-bit codes, interleaved)
+    uint16_t d           bytes 80..81   (fp16 super-block scale)
+    uint16_t dmin        bytes 82..83   (fp16 super-block min scale)
+
+The 256 elements are 16 sub-blocks of 16 (``is`` = 0..15).  Antirez's Q2_K
+uses the RAW 2-bit codes {0,1,2,3} -- *no* ``kvalues_iq2xs`` lookup (the
+llama.cpp standard path uses kvalues; antirez's CUDA dot path does NOT, so
+this kernel intentionally matches the production CUDA math bit-for-bit).
+Per sub-block ``is``::
+
+    k         = is // 8          (0 for is<8, 1 for is>=8)
+    within    = is % 8
+    j         = within // 2
+    half      = within % 2
+    byte_base = k*32 + half*16
+    shift     = j * 2
+    scale     = scales[is] & 0x0f
+    min       = scales[is] >> 4
+    code[i]   = (qs[byte_base + i] >> shift) & 0x03       (i = 0..15)
+    y[i]      = d * scale * code[i]  -  dmin * min
+
+PAIRING OBSERVATION (the structural bridge to the IQ2_XXS template):
+adjacent sub-blocks ``is0 = 2*ip`` and ``is1 = 2*ip+1`` share the same
+``k0 = is0//8`` and the same ``shift = (ip % 4) * 2``; they differ only in
+``half`` (byte_base offset 0 vs 16 within the ``k0*32`` window).  So for each
+pair ``ip`` (0..7) the kernel loads ONE 32-byte qs window
+``qs[k0*32 .. k0*32+32]``, shifts+masks all 32 codes at once, selects
+scale/min per half via ``tl.where(j >= 16)``, and emits ONE [BLOCK_N, 32]
+fp32 weight tile straight into a tf32 ``tl.dot`` (Ada tf32 tensor cores,
+10-bit mantissa) with the matching [BLOCK_M, 32] A tile.  That is 8 tf32
+MMAs per 256-K block -- exactly the IQ2_XXS kernel's contraction shape,
+just with the Q2_K dequant in place of the IQ2_XXS grid lookup.  No lookup
+tables are needed (raw codes), so the wrapper takes no LUT args.
+
+Why this kernel exists (the three de-risk questions, mirroring Step 4b):
+
+  1. REGISTER / SHARED-MEMORY PRESSURE.  Per N-row, one 256-K Q2_K block is
+     84 bytes of HBM (16 blocks per K=4096 row = 1344 bytes).  The kernel
+     decodes ONE 32-element pair at a time straight into a [BLOCK_N, 32] fp32
+     register tile (2 KiB at BLOCK_N=16), dots it (tf32 MMA), and folds the
+     result into the [BLOCK_M, BLOCK_N] fp32 accumulator -- live decoded
+     footprint is O(BLOCK_N * 32) fp32, not O(BLOCK_N * 256).  No LUT is
+     touched (codes are raw), so there is no grid L1 residency requirement at
+     all.  -> fits without spill cliffs (validated: compiles + runs at the
+     speeds reported by ``__main__``).
+
+  2. ACCURACY.  Decode happens in fp32 (matching the Step-0 reference) and is
+     kept in fp32 at the ``tl.dot`` boundary (NO bf16 cast), so the only loss
+     vs the fp32-dequant reference is tf32-MMA rounding (10-bit mantissa on
+     Ada -- 3 more bits than the bf16-MMA the IQ2_XXS/{-4,-1,1,4} kernels
+     accept).  The earlier bf16 dot rounded the small dequanted weights
+     coarsely enough to fail the 16K needle; tf32 restores the precision.
+     ``__main__`` measures the gap vs the CPU-reference dequant + torch fp32
+     matmul AND vs a bf16-GPU matmul (which isolates the MMA accum-order
+     gap).  A dedicated fp32 dequant kernel (``_q2_k_dequant_kernel`` +
+     ``q2_k_dequant``) proves the fp32 dequant arithmetic matches the
+     reference bit-for-bit (modulo unavoidable GPU-FMA vs CPU rounding on a
+     handful of ULPs, far below the gate).
+
+  3. PERFORMANCE.  The fused kernel reads 2.625 bits/element of weight HBM
+     (84 B / 256 elems) instead of 16 bit/elem (bf16), so it is HBM-cheap
+     even though the dequant ALU is real.  ``__main__`` optionally reports
+     kernel time vs ``torch.matmul`` (bf16, tensor cores) on the same shape.
+
+NOT integrated into vLLM MoE dispatch -- this is the standalone proof.  The
+DOWN-projection per-expert shape used here is M (tokens) x N=2048 x K=4096
+(the DSv4 ``ffn_down_exps`` per-expert slab, Q2_K; dims
+[n_out=2048, n_in=4096, n_experts=256]).
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+import time
+from typing import Optional, Tuple
+
+import numpy as np
+import torch
+import triton
+import triton.language as tl
+
+# Reuse the proven CPU reference + GGUF parser.
+try:
+    from .iq2_xxs_ref import (
+        QK_K,
+        Q2_K_BLOCK_BYTES,
+        dequant_q2_k,
+        parse_gguf_header,
+        find_tensors_by_prefix,
+        GGUF_TYPE_Q2_K,
+    )
+except ImportError:  # standalone execution
+    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+    from iq2_xxs_ref import (  # type: ignore[no-redef]
+        QK_K,
+        Q2_K_BLOCK_BYTES,
+        dequant_q2_k,
+        parse_gguf_header,
+        find_tensors_by_prefix,
+        GGUF_TYPE_Q2_K,
+    )
+
+
+DEFAULT_GGUF = "/root/antirez/ds4/ds4flash.gguf"
+
+
+# ---------------------------------------------------------------------------
+# Triton fused GEMM kernel: one program per BLOCK_N-row N-tile.
+#
+# Contraction strategy: iterate over K one Q2_K block (256 elems) at a time;
+# inside each block, static-unroll the 8 PAIRS of sub-blocks (pair ip covers
+# sub-blocks 2*ip and 2*ip+1 -> a contiguous 32-wide K-stripe), decoding each
+# 32-wide W stripe straight into an fp32 register tile and dotting it (tf32
+# MMA) with the matching [BLOCK_M, 32] A tile.  This mirrors the IQ2_XXS
+# kernel's 32-group contraction with the Q2_K dequant (scale/min + raw 2-bit
+# codes) in place of the IQ2_XXS codebook.
+# ---------------------------------------------------------------------------
+@triton.jit
+def _q2_k_mm_kernel(
+    a_ptr,        # *bf16 [M, K]
+    w_ptr,        # *uint8 [N, BLOCKS_PER_ROW * 84]
+    c_ptr,        # *bf16 [M, N]
+    M,            # runtime rows of A (for masking when M < BLOCK_M)
+    N_RUNTIME,    # runtime rows of W
+    stride_am, stride_ak,
+    stride_wn,
+    stride_cm, stride_cn,
+    BLOCKS_PER_ROW: tl.constexpr,   # K // 256
+    K: tl.constexpr,                # contraction dim (e.g. 4096)
+    BLOCK_M: tl.constexpr,          # tl.dot needs >= 16
+    BLOCK_N: tl.constexpr,          # tl.dot needs >= 16
+    BLOCK_BYTES: tl.constexpr,      # 84
+):
+    pid_n = tl.program_id(0)
+    pid_m = tl.program_id(1)
+
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
+    mask_m = offs_m < M
+    mask_n = offs_n < N_RUNTIME
+
+    # Decode constants (all constexpr aranges).
+    i32 = tl.arange(0, 32)          # within-pair element index (K-stripe)
+    is_half1 = i32 >= 16            # [32] bool: which half of the pair
+
+    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+
+    for kb in range(BLOCKS_PER_ROW):
+        # ---- per-N-row block base (84 bytes per Q2_K block) ---------------
+        block_base = offs_n * stride_wn + kb * BLOCK_BYTES         # [BLOCK_N]
+
+        # ---- d (fp16) and dmin (fp16) -- shared across all 16 sub-blocks --
+        d_lo = tl.load(w_ptr + block_base + 80, mask=mask_n, other=0).to(tl.uint32)
+        d_hi = tl.load(w_ptr + block_base + 81, mask=mask_n, other=0).to(tl.uint32)
+        d_u16 = (d_lo | (d_hi << 8)).to(tl.uint16)
+        d_fp32 = d_u16.to(tl.float16, bitcast=True).to(tl.float32)     # [BLOCK_N]
+
+        dm_lo = tl.load(w_ptr + block_base + 82, mask=mask_n, other=0).to(tl.uint32)
+        dm_hi = tl.load(w_ptr + block_base + 83, mask=mask_n, other=0).to(tl.uint32)
+        dmin_u16 = (dm_lo | (dm_hi << 8)).to(tl.uint16)
+        dmin_fp32 = dmin_u16.to(tl.float16, bitcast=True).to(tl.float32)  # [BLOCK_N]
+
+        # ---- 8 pairs of sub-blocks (each -> 32-wide K-stripe) -------------
+        for ip in tl.static_range(8):
+            is0 = 2 * ip               # even sub-block of the pair
+            is1 = 2 * ip + 1           # odd sub-block
+            k0 = is0 // 8              # 0 for ip<4, 1 for ip>=4
+            shift = (ip % 4) * 2       # 0,2,4,6,0,2,4,6
+
+            # scales[is0] / scales[is1] -> per-sub-block 4-bit scale & min.
+            s0 = tl.load(w_ptr + block_base + is0, mask=mask_n, other=0).to(tl.uint32)
+            s1 = tl.load(w_ptr + block_base + is1, mask=mask_n, other=0).to(tl.uint32)
+            scale0 = (s0 & 0xF).to(tl.float32)
+            min0 = (s0 >> 4).to(tl.float32)
+            scale1 = (s1 & 0xF).to(tl.float32)
+            min1 = (s1 >> 4).to(tl.float32)
+
+            # qs window: 32 bytes at block offset 16 + k0*32 (covers both
+            # halves of this k-group).  half=0 (sub-block is0) is bytes
+            # [0..15], half=1 (sub-block is1) is bytes [16..31]; both share
+            # the same shift.  The +16 skips the 16 scale bytes (qs lives at
+            # block bytes 16..79).
+            qs_offs = 16 + k0 * 32 + i32                            # [32]
+            qs_window = tl.load(
+                w_ptr + block_base[:, None] + qs_offs[None, :],
+                mask=mask_n[:, None], other=0,
+            ).to(tl.uint32)                                         # [BLOCK_N, 32]
+            codes = (qs_window >> shift) & 0x3                      # [BLOCK_N, 32], 0..3
+            codes_f = codes.to(tl.float32)
+
+            # Per-half scale/min selection (half 0 -> is0, half 1 -> is1).
+            scale_vec = tl.where(
+                is_half1[None, :], scale1[:, None], scale0[:, None]
+            )                                                       # [BLOCK_N, 32]
+            min_vec = tl.where(
+                is_half1[None, :], min1[:, None], min0[:, None]
+            )                                                       # [BLOCK_N, 32]
+
+            # Q2_K dequant: y = d * scale * code - dmin * min (fp32).
+            y = d_fp32[:, None] * scale_vec * codes_f \
+                - dmin_fp32[:, None] * min_vec                      # [BLOCK_N, 32]
+            # KEEP fp32 -- do NOT cast to bf16.  bf16's 7-bit mantissa loses
+            # precision on the small dequanted weight values; across 43 layers
+            # x long context the rounding compounds (the 16K-needle failure
+            # mode).  fp32 operands feed tf32 tensor cores on Ada (10-bit
+            # mantissa via allow_tf32) -- 3 extra mantissa bits over bf16.
+            w_tile = y                                              # [BLOCK_N, 32] fp32
+
+            # A tile [BLOCK_M, 32] for this pair's K-window.
+            k_glob = kb * 256 + ip * 32 + i32                      # [32]
+            a_tile = tl.load(
+                a_ptr + offs_m[:, None] * stride_am + k_glob[None, :] * stride_ak,
+                mask=mask_m[:, None], other=0.0,
+            ).to(tl.float32)                                        # [BLOCK_M, 32] fp32
+
+            # Fused tf32 dot (fp32 operands -> Ada tf32 MMA, 10-bit mantissa),
+            # fp32 accumulate.  allow_tf32=True is the default on Ada but set
+            # explicitly here so the precision choice is obvious at the call.
+            acc += tl.dot(a_tile, tl.trans(w_tile), allow_tf32=True)
+
+    tl.store(
+        c_ptr + offs_m[:, None] * stride_cm + offs_n[None, :] * stride_cn,
+        acc.to(tl.bfloat16),
+        mask=mask_m[:, None] & mask_n[None, :],
+    )
+
+
+# ---------------------------------------------------------------------------
+# Triton fp32 dequant kernel (bit-exactness probe).
+#
+# Decodes Q2_K bytes straight to fp32 using the SAME arithmetic as the GEMM
+# kernel (just without the bf16 cast + dot), so a comparison vs the CPU
+# reference ``iq2_xxs_ref.dequant_q2_k`` isolates the dequant correctness
+# from the bf16-MMA error.  Any non-zero delta here is pure GPU-FMA vs CPU
+# rounding (a few ULPs); the math itself is proven identical.
+# ---------------------------------------------------------------------------
+@triton.jit
+def _q2_k_dequant_kernel(
+    w_ptr,        # *uint8 [N, BLOCKS_PER_ROW * 84]
+    out_ptr,      # *fp32 [N, K]
+    N_RUNTIME,
+    stride_wn,
+    stride_on, stride_ok,
+    BLOCKS_PER_ROW: tl.constexpr,
+    K: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+    BLOCK_BYTES: tl.constexpr,
+):
+    pid_n = tl.program_id(0)
+    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
+    mask_n = offs_n < N_RUNTIME
+
+    i32 = tl.arange(0, 32)
+    is_half1 = i32 >= 16
+
+    for kb in range(BLOCKS_PER_ROW):
+        block_base = offs_n * stride_wn + kb * BLOCK_BYTES         # [BLOCK_N]
+
+        d_lo = tl.load(w_ptr + block_base + 80, mask=mask_n, other=0).to(tl.uint32)
+        d_hi = tl.load(w_ptr + block_base + 81, mask=mask_n, other=0).to(tl.uint32)
+        d_u16 = (d_lo | (d_hi << 8)).to(tl.uint16)
+        d_fp32 = d_u16.to(tl.float16, bitcast=True).to(tl.float32)
+
+        dm_lo = tl.load(w_ptr + block_base + 82, mask=mask_n, other=0).to(tl.uint32)
+        dm_hi = tl.load(w_ptr + block_base + 83, mask=mask_n, other=0).to(tl.uint32)
+        dmin_u16 = (dm_lo | (dm_hi << 8)).to(tl.uint16)
+        dmin_fp32 = dmin_u16.to(tl.float16, bitcast=True).to(tl.float32)
+
+        for ip in tl.static_range(8):
+            is0 = 2 * ip
+            is1 = 2 * ip + 1
+            k0 = is0 // 8
+            shift = (ip % 4) * 2
+
+            s0 = tl.load(w_ptr + block_base + is0, mask=mask_n, other=0).to(tl.uint32)
+            s1 = tl.load(w_ptr + block_base + is1, mask=mask_n, other=0).to(tl.uint32)
+            scale0 = (s0 & 0xF).to(tl.float32)
+            min0 = (s0 >> 4).to(tl.float32)
+            scale1 = (s1 & 0xF).to(tl.float32)
+            min1 = (s1 >> 4).to(tl.float32)
+
+            qs_offs = 16 + k0 * 32 + i32
+            qs_window = tl.load(
+                w_ptr + block_base[:, None] + qs_offs[None, :],
+                mask=mask_n[:, None], other=0,
+            ).to(tl.uint32)
+            codes_f = ((qs_window >> shift) & 0x3).to(tl.float32)
+
+            scale_vec = tl.where(
+                is_half1[None, :], scale1[:, None], scale0[:, None]
+            )
+            min_vec = tl.where(
+                is_half1[None, :], min1[:, None], min0[:, None]
+            )
+
+            y = d_fp32[:, None] * scale_vec * codes_f \
+                - dmin_fp32[:, None] * min_vec                      # [BLOCK_N, 32] fp32
+
+            k_glob = kb * 256 + ip * 32 + i32
+            tl.store(
+                out_ptr + offs_n[:, None] * stride_on + k_glob[None, :] * stride_ok,
+                y,
+                mask=mask_n[:, None],
+            )
+
+
+# ---------------------------------------------------------------------------
+# Python wrappers.
+# ---------------------------------------------------------------------------
+def q2_k_mm(
+    a_bf16: torch.Tensor,
+    w_q2k_bytes: torch.Tensor,
+    w_shape: Tuple[int, int],
+    *,
+    block_m: int = 16,
+    block_n: int = 16,
+    num_warps: int = 2,
+) -> torch.Tensor:
+    """Fused Q2_K GEMM: C[M,N] = A[M,K] @ W[N,K]^T.
+
+    Args:
+        a_bf16: bf16 activations ``[M, K]``.
+        w_q2k_bytes: uint8 tensor holding the raw Q2_K blocks of W.  Either
+            flat ``[N * blocks_per_row * 84]`` or pre-shaped
+            ``[N, blocks_per_row * 84]``.  ``blocks_per_row = K // 256``.
+        w_shape: ``(N, K)`` logical weight shape.  ``K`` must be a multiple
+            of 256.  The byte layout is the same block-linear layout that
+            ``iq2_xxs_ref.dequant_q2_k(bytes, (N, K))`` consumes, i.e.
+            element ``W[n, k]`` lives in Q2_K block ``(n, k // 256)`` at
+            within-block position ``k % 256`` -- so reshape-to-(N,K) of the
+            reference dequant matches this kernel byte-for-byte.
+        block_m / block_n: Triton tile sizes (must be >= 16 for tl.dot).
+            The kernel tiles across BOTH M and N (grid is
+            ``(cdiv(N, block_n), cdiv(M, block_m))``), so any ``block_m`` >= 16
+            handles any M.
+        num_warps: Triton warp count.
+
+    Returns:
+        bf16 ``[M, N]`` tensor on the same device as ``a_bf16``.
+    """
+    if a_bf16.dtype != torch.bfloat16:
+        raise TypeError(f"A must be bf16, got {a_bf16.dtype}")
+    if w_q2k_bytes.dtype != torch.uint8:
+        raise TypeError(f"W bytes must be uint8, got {w_q2k_bytes.dtype}")
+    M, K_a = a_bf16.shape
+    N, K = w_shape
+    if K != K_a:
+        raise ValueError(f"K mismatch: A has K={K_a}, w_shape has K={K}")
+    if K % QK_K != 0:
+        raise ValueError(f"K={K} must be a multiple of {QK_K}")
+    blocks_per_row = K // QK_K
+    row_bytes = blocks_per_row * Q2_K_BLOCK_BYTES
+
+    if block_m < 16:
+        raise ValueError(f"block_m must be >= 16 (tl.dot), got {block_m}")
+    if block_n < 16:
+        raise ValueError(f"block_n must be >= 16 (tl.dot), got {block_n}")
+
+    device = a_bf16.device
+    a_bf16 = a_bf16.contiguous()
+    w = w_q2k_bytes.reshape(-1).contiguous().to(device)
+    if w.numel() != N * row_bytes:
+        raise ValueError(
+            f"W bytes: have {w.numel()} (= {w.numel() // row_bytes} N-rows), "
+            f"expected {N * row_bytes} (= {N} N-rows x {row_bytes} B)."
+        )
+    w = w.reshape(N, row_bytes)
+
+    c = torch.empty((M, N), dtype=torch.bfloat16, device=device)
+
+    grid_dim = (triton.cdiv(N, block_n), triton.cdiv(M, block_m))
+    _q2_k_mm_kernel[grid_dim](
+        a_bf16,
+        w,
+        c,
+        M,
+        N,
+        a_bf16.stride(0), a_bf16.stride(1),
+        w.stride(0),
+        c.stride(0), c.stride(1),
+        BLOCKS_PER_ROW=blocks_per_row,
+        K=K,
+        BLOCK_M=block_m,
+        BLOCK_N=block_n,
+        BLOCK_BYTES=Q2_K_BLOCK_BYTES,
+        num_warps=num_warps,
+    )
+    return c
+
+
+def q2_k_dequant(
+    w_q2k_bytes: torch.Tensor,
+    w_shape: Tuple[int, int],
+    *,
+    block_n: int = 16,
+    num_warps: int = 2,
+) -> torch.Tensor:
+    """GPU fp32 dequant of Q2_K bytes (bit-exactness probe for ``__main__``).
+
+    Returns fp32 ``[N, K]`` on the same device as ``w_q2k_bytes``.  Uses the
+    IDENTICAL decode arithmetic as :func:`q2_k_mm` (no bf16 cast, no dot) so a
+    comparison vs ``iq2_xxs_ref.dequant_q2_k`` isolates the dequant math from
+    the bf16-MMA error.
+    """
+    if w_q2k_bytes.dtype != torch.uint8:
+        raise TypeError(f"W bytes must be uint8, got {w_q2k_bytes.dtype}")
+    N, K = w_shape
+    if K % QK_K != 0:
+        raise ValueError(f"K={K} must be a multiple of {QK_K}")
+    blocks_per_row = K // QK_K
+    row_bytes = blocks_per_row * Q2_K_BLOCK_BYTES
+
+    device = w_q2k_bytes.device
+    w = w_q2k_bytes.reshape(-1).contiguous().to(device)
+    if w.numel() != N * row_bytes:
+        raise ValueError(
+            f"W bytes: have {w.numel()}, expected {N * row_bytes}"
+        )
+    w = w.reshape(N, row_bytes)
+
+    out = torch.empty((N, K), dtype=torch.float32, device=device)
+
+    grid_dim = (triton.cdiv(N, block_n),)
+    _q2_k_dequant_kernel[grid_dim](
+        w,
+        out,
+        N,
+        w.stride(0),
+        out.stride(0), out.stride(1),
+        BLOCKS_PER_ROW=blocks_per_row,
+        K=K,
+        BLOCK_N=block_n,
+        BLOCK_BYTES=Q2_K_BLOCK_BYTES,
+        num_warps=num_warps,
+    )
+    return out
+
+
+# ---------------------------------------------------------------------------
+# Validation helpers.
+# ---------------------------------------------------------------------------
+def _compare(
+    ref: np.ndarray, got: np.ndarray
+) -> Tuple[float, float, float, float]:
+    """Return (max_abs, worst_rel, max_rel_elem, rel_l2).
+
+    Metrics (same conventions as ``iq2_xxs_mm_triton._compare`` and the
+    shipped {-4,-1,1,4} kernel gate):
+
+    * ``max_abs``      : max |ref - got|.
+    * ``worst_rel``    : ``max_abs / max|ref|`` -- the production-style gate.
+    * ``max_rel_elem`` : max |ref-got|/|ref| over |ref|>1e-8 (informational).
+    * ``rel_l2``       : ||ref-got||_2 / ||ref||_2.
+    """
+    abs_diff = np.abs(ref - got)
+    max_abs = float(abs_diff.max()) if abs_diff.size else 0.0
+    ref_abs_max = float(np.abs(ref).max()) if ref.size else 0.0
+    worst_rel = (max_abs / ref_abs_max) if ref_abs_max > 0 else 0.0
+    nz = np.abs(ref) > 1e-8
+    max_rel_elem = (
+        float((abs_diff[nz] / np.abs(ref)[nz]).max()) if nz.any() else 0.0
+    )
+    denom = float(np.linalg.norm(ref))
+    rel_l2 = float(np.linalg.norm(ref - got) / denom) if denom > 0 else 0.0
+    return max_abs, worst_rel, max_rel_elem, rel_l2
+
+
+def _make_random_q2_k_weights(
+    n: int, k: int, seed: int = 0
+) -> np.ndarray:
+    """Random VALID Q2_K byte blocks for an [N, K] weight, [N, row_bytes] uint8.
+
+    Any fp16 d/dmin + any scales/qs bytes is a valid Q2_K encoding, so we
+    sample all of them uniformly.  d/dmin are sampled in a sane positive
+    fp16 range.
+    """
+    rng = np.random.default_rng(seed)
+    blocks_per_row = k // QK_K
+    row_bytes = blocks_per_row * Q2_K_BLOCK_BYTES
+    n_blocks = n * blocks_per_row
+    out = np.zeros((n_blocks, Q2_K_BLOCK_BYTES), dtype=np.uint8)
+    # scales[16] and qs[64]: any byte pattern is valid.
+    out[:, 0:16] = rng.integers(0, 256, size=(n_blocks, 16), dtype=np.uint8)
+    out[:, 16:80] = rng.integers(0, 256, size=(n_blocks, 64), dtype=np.uint8)
+    # d (bytes 80-81) and dmin (bytes 82-83): positive fp16.
+    d = rng.uniform(0.001, 1.0, size=n_blocks).astype(np.float16)
+    dmin = rng.uniform(0.0, 0.5, size=n_blocks).astype(np.float16)
+    out[:, 80:82] = d.view(np.uint8).reshape(n_blocks, 2)
+    out[:, 82:84] = dmin.view(np.uint8).reshape(n_blocks, 2)
+    return out.reshape(n, row_bytes)
+
+
+def _reference(
+    a_bf16: torch.Tensor,
+    w_bytes_flat: bytes,
+    w_shape: Tuple[int, int],
+    device: torch.device,
+) -> torch.Tensor:
+    """CPU reference: dequant W (fp32) -> bf16 -> matmul fp32-accumulate.
+
+    Returns the fp32 reference C on ``device``.
+    """
+    N, K = w_shape
+    w_fp32 = dequant_q2_k(w_bytes_flat, (N, K))                    # numpy fp32 [N,K]
+    w_bf16 = torch.from_numpy(np.ascontiguousarray(w_fp32)).to(torch.bfloat16)
+    # A is bf16 -> .float() is a lossless widen; fp32 matmul.
+    c_ref = a_bf16.cpu().float() @ w_bf16.float().t()             # [M,N] fp32
+    return c_ref.to(device)
+
+
+def _validate_dequant_bitexact(
+    n: int, k: int, seed: int, device: torch.device
+) -> dict:
+    """Bit-exactness probe: GPU fp32 dequant vs CPU reference dequant.
+
+    Uses :func:`q2_k_dequant` (same arithmetic as the GEMM kernel, no bf16
+    cast) so any delta is pure GPU-FMA vs CPU rounding (a few ULPs).
+    """
+    w_bytes_np = _make_random_q2_k_weights(n, k, seed=seed)
+    w_bytes_flat = w_bytes_np.tobytes()
+    w_bytes_t = torch.from_numpy(w_bytes_np.copy()).to(device)
+
+    gpu = q2_k_dequant(w_bytes_t, (n, k)).cpu().numpy()            # [N,K] fp32
+    ref = dequant_q2_k(w_bytes_flat, (n, k))                       # [N,K] fp32
+
+    max_abs, worst_rel, max_rel_elem, rel_l2 = _compare(ref, gpu)
+    # Exact-match count (how many of N*K elements are bit-identical).
+    exact = int(np.sum(ref == gpu))
+    total = ref.size
+    return {
+        "n": n, "k": k,
+        "max_abs": max_abs,
+        "worst_rel": worst_rel,
+        "max_rel_elem": max_rel_elem,
+        "rel_l2": rel_l2,
+        "exact_frac": exact / total,
+        "total": total,
+    }
+
+
+def _validate_random(
+    m: int, n: int, k: int, seed: int, device: torch.device
+) -> dict:
+    """Random-Q2_K GEMM validation at the given (M, N, K)."""
+    w_bytes_np = _make_random_q2_k_weights(n, k, seed=seed)        # [N, row_bytes]
+    w_bytes_flat = w_bytes_np.tobytes()
+    w_bytes_t = torch.from_numpy(w_bytes_np.copy())
+
+    rng = torch.Generator().manual_seed(seed + 17)
+    a_bf16 = (torch.randn(m, k, generator=rng) * 0.3).to(torch.bfloat16)
+
+    c_tri = q2_k_mm(a_bf16.to(device), w_bytes_t.to(device), (n, k))
+    c_ref = _reference(a_bf16, w_bytes_flat, (n, k), device)       # fp32 on device
+
+    got = c_tri.float().cpu().numpy()
+    ref = c_ref.cpu().numpy()
+    max_abs, worst_rel, max_rel_elem, rel_l2 = _compare(ref, got)
+
+    # bf16-GPU matmul reference (closest to kernel math, isolates accum order).
+    w_fp32 = dequant_q2_k(w_bytes_flat, (n, k))
+    w_bf16 = torch.from_numpy(np.ascontiguousarray(w_fp32)).to(torch.bfloat16).to(device)
+    with torch.no_grad():
+        c_bf16gpu = torch.matmul(a_bf16.to(device), w_bf16.t()).float().cpu().numpy()
+    _, worst_rel_bf16, _, rel_l2_vsbf16 = _compare(c_bf16gpu, got)
+
+    return {
+        "m": m, "n": n, "k": k,
+        "max_abs": max_abs, "worst_rel": worst_rel,
+        "max_rel_elem": max_rel_elem, "rel_l2": rel_l2,
+        "worst_rel_vs_bf16gpu": worst_rel_bf16,
+        "rel_l2_vs_bf16gpu": rel_l2_vsbf16,
+        "ref_abs_max": float(np.abs(ref).max()),
+    }
+
+
+def _load_gguf_q2_k_expert(
+    gguf_path: str, tensor_name_prefix: str = "blk.0.ffn_down_exps."
+) -> Optional[Tuple[np.ndarray, Tuple[int, int]]]:
+    """Read expert-0's raw Q2_K bytes for a DSv4 ffn_down_exps tensor.
+
+    Returns (flat_bytes_uint8, (N, K)).  For DSv4 ``ffn_down_exps`` dims
+    [ne0=2048, ne1=4096, ne2=256], expert 0's slab is 2048 * 16 = 32768 Q2_K
+    blocks = 2,752,512 bytes; we interpret it as (N=2048, K=4096), i.e.
+    N=ne0 (out), K=ne1 (in) -- matching the task's DOWN-projection shape.
+    """
+    if not os.path.exists(gguf_path):
+        return None
+    import mmap
+    with open(gguf_path, "rb") as fh:
+        with mmap.mmap(fh.fileno(), 0, prot=mmap.PROT_READ) as mm:
+            buf = bytes(mm[: 64 * 1024 * 1024])
+            tensors, data_off, _align = parse_gguf_header(buf)
+    cands = find_tensors_by_prefix(tensors, tensor_name_prefix, GGUF_TYPE_Q2_K)
+    if not cands:
+        return None
+    t = cands[0]
+    # dims are [ne0, ne1, ne2]; pick N = ne0, K = ne1 (K must be multiple of 256).
+    ne = t.dims
+    if len(ne) < 2:
+        return None
+    n, k = int(ne[0]), int(ne[1])
+    if k % QK_K != 0:
+        # try the other orientation
+        n, k = int(ne[1]), int(ne[0])
+        if k % QK_K != 0:
+            return None
+    blocks_per_row = k // QK_K
+    # Per-expert byte count (one slab along the slowest dim).
+    expert_bytes = n * blocks_per_row * Q2_K_BLOCK_BYTES
+    abs_off = data_off + t.offset
+    with open(gguf_path, "rb") as bf:
+        bf.seek(abs_off)
+        raw = bf.read(expert_bytes)
+    if len(raw) != expert_bytes:
+        return None
+    return np.frombuffer(raw, dtype=np.uint8).copy(), (n, k)
+
+
+def _validate_gguf(
+    gguf_path: str, m: int, device: torch.device,
+    tensor_name_prefix: str = "blk.0.ffn_down_exps.",
+) -> Optional[dict]:
+    res = _load_gguf_q2_k_expert(gguf_path, tensor_name_prefix)
+    if res is None:
+        return None
+    w_bytes_np, (n, k) = res
+    w_bytes_flat = w_bytes_np.tobytes()
+    w_bytes_t = torch.from_numpy(w_bytes_np)
+
+    rng = torch.Generator().manual_seed(123)
+    a_bf16 = (torch.randn(m, k, generator=rng) * 0.3).to(torch.bfloat16)
+
+    c_tri = q2_k_mm(a_bf16.to(device), w_bytes_t.to(device), (n, k))
+    c_ref = _reference(a_bf16, w_bytes_flat, (n, k), device)
+
+    got = c_tri.float().cpu().numpy()
+    ref = c_ref.cpu().numpy()
+    max_abs, worst_rel, max_rel_elem, rel_l2 = _compare(ref, got)
+
+    w_fp32 = dequant_q2_k(w_bytes_flat, (n, k))
+    w_bf16 = torch.from_numpy(np.ascontiguousarray(w_fp32)).to(torch.bfloat16).to(device)
+    with torch.no_grad():
+        c_bf16gpu = torch.matmul(a_bf16.to(device), w_bf16.t()).float().cpu().numpy()
+    _, worst_rel_bf16, _, rel_l2_vsbf16 = _compare(c_bf16gpu, got)
+
+    # Also dequant bit-exactness on the real weights.
+    gpu_dec = q2_k_dequant(w_bytes_t.to(device), (n, k)).cpu().numpy()
+    dec_max_abs, dec_worst_rel, _, _ = _compare(ref_w := w_fp32, gpu_dec)
+
+    return {
+        "m": m, "n": n, "k": k,
+        "max_abs": max_abs, "worst_rel": worst_rel,
+        "max_rel_elem": max_rel_elem, "rel_l2": rel_l2,
+        "worst_rel_vs_bf16gpu": worst_rel_bf16,
+        "rel_l2_vs_bf16gpu": rel_l2_vsbf16,
+        "ref_abs_max": float(np.abs(ref).max()),
+        "dequant_max_abs": dec_max_abs,
+        "dequant_worst_rel": dec_worst_rel,
+    }
+
+
+def _bench(
+    a_bf16: torch.Tensor,
+    w_bytes_t: torch.Tensor,
+    w_shape: Tuple[int, int],
+    device: torch.device,
+    repeats: int = 50,
+) -> Tuple[float, float, float]:
+    """Time the fused kernel vs torch.matmul (bf16). Returns (kernel_ms,
+    torch_matmul_ms, kernel_tflops)."""
+    n, k = w_shape
+    # Warmup + time fused kernel.
+    for _ in range(5):
+        q2_k_mm(a_bf16, w_bytes_t, w_shape)
+    if device.type == "cuda":
+        torch.cuda.synchronize()
+        s, e = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+        s.record()
+        for _ in range(repeats):
+            q2_k_mm(a_bf16, w_bytes_t, w_shape)
+        e.record()
+        torch.cuda.synchronize()
+        kernel_ms = s.elapsed_time(e) / repeats
+    else:
+        t0 = time.perf_counter()
+        for _ in range(repeats):
+            q2_k_mm(a_bf16, w_bytes_t, w_shape)
+        kernel_ms = (time.perf_counter() - t0) / repeats * 1000.0
+
+    m = a_bf16.shape[0]
+    flops = 2.0 * m * n * k
+    kernel_tflops = flops / (kernel_ms / 1000.0) / 1e12
+
+    # torch.matmul reference (bf16, tensor cores).
+    w_fp32 = dequant_q2_k(w_bytes_t.cpu().numpy().tobytes(), (n, k))
+    w_bf16 = torch.from_numpy(np.ascontiguousarray(w_fp32)).to(torch.bfloat16).to(device)
+    a_dev = a_bf16.to(device)
+    for _ in range(5):
+        torch.matmul(a_dev, w_bf16.t())
+    if device.type == "cuda":
+        torch.cuda.synchronize()
+        s, e = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+        s.record()
+        for _ in range(repeats):
+            torch.matmul(a_dev, w_bf16.t())
+        e.record()
+        torch.cuda.synchronize()
+        torch_ms = s.elapsed_time(e) / repeats
+    else:
+        t0 = time.perf_counter()
+        for _ in range(repeats):
+            torch.matmul(a_dev, w_bf16.t())
+        torch_ms = (time.perf_counter() - t0) / repeats * 1000.0
+
+    return kernel_ms, torch_ms, kernel_tflops
+
+
+def main(argv=None) -> int:
+    import argparse
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--device", default="cuda")
+    parser.add_argument("--seed", type=int, default=0)
+    parser.add_argument("--gguf", default=DEFAULT_GGUF)
+    parser.add_argument(
+        "--no-gguf", action="store_true",
+        help="skip the real-GGUF validation even if the file is present",
+    )
+    parser.add_argument(
+        "--bench", action="store_true",
+        help="also run a small kernel-vs-torch.matmul timing comparison",
+    )
+    args = parser.parse_args(argv)
+
+    if args.device.startswith("cuda") and not torch.cuda.is_available():
+        print("[q2_k_mm] CUDA not available; falling back to CPU")
+        device = torch.device("cpu")
+    else:
+        device = torch.device(args.device)
+    print(f"[q2_k_mm] device: {device}")
+
+    overall_pass = True
+    tol_rel = 2.5e-2   # gate, same as the IQ2_XXS / {-4,-1,1,4} kernel self-test.
+
+    # ----- Bit-exact fp32 dequant probe (small, full-row) ----------------
+    print("\n=== Q2_K fp32 dequant bit-exactness (GPU vs CPU reference) ===")
+    # Small N so the exact-frac count is meaningful; K = full DOWN input dim.
+    dres = _validate_dequant_bitexact(n=32, k=4096, seed=args.seed, device=device)
+    print(f"  shape N={dres['n']} K={dres['k']}  ({dres['total']} elems)")
+    print(f"  max abs diff          : {dres['max_abs']:.3e}")
+    print(f"  worst_rel             : {dres['worst_rel']:.3e}   "
+          f"[dequant-only; ~0 ideal, GPU-FMA may add a few ULPs]")
+    print(f"  rel L2                : {dres['rel_l2']:.3e}")
+    print(f"  bit-exact frac        : {dres['exact_frac']*100:.4f}%")
+    ok_deq = dres["worst_rel"] < 1e-5   # dequant must be effectively exact
+    overall_pass = overall_pass and ok_deq
+    print(f"  RESULT (dequant gate 1e-5): {'PASS' if ok_deq else 'FAIL'}")
+
+    # ----- Random validation at the two target M values ------------------
+    N, K = 2048, 4096    # DSv4 ffn_down_exps per-expert (out, in).
+    # Include M > BLOCK_M (16) so the M-tiling grid is exercised -- earlier
+    # the kernel only tiled across N and silently dropped rows [16, M).
+    for M in (4, 8, 17, 64, 512):
+        print(f"\n=== Random Q2_K GEMM  M={M}  N={N}  K={K} ===")
+        r = _validate_random(M, N, K, seed=args.seed, device=device)
+        print(f"  ref |C|_max            : {r['ref_abs_max']:.4f}")
+        print(f"  max abs diff          : {r['max_abs']:.3e}")
+        print(f"  worst_rel (prod gate) : {r['worst_rel']:.3e}   "
+              f"[= max_abs / ref |C|_max; ~2-3e-3 like the IQ2_XXS kernel]")
+        print(f"  rel L2      (vs fp32) : {r['rel_l2']:.3e}")
+        print(f"  worst_rel vs bf16-GPU : {r['worst_rel_vs_bf16gpu']:.3e}   "
+              f"(isolates bf16-MMA accum-order)")
+        print(f"  rel L2      vs bf16   : {r['rel_l2_vs_bf16gpu']:.3e}")
+        print(f"  max_rel_elem (vs fp32): {r['max_rel_elem']:.3e}   "
+              f"[informational; spikes at near-zero ref]")
+        ok = (r["worst_rel"] < tol_rel) and np.isfinite(r["worst_rel"])
+        overall_pass = overall_pass and ok
+        print(f"  RESULT (gate {tol_rel:.0e})    : {'PASS' if ok else 'FAIL'} "
+              f"on worst_rel")
+
+    # ----- Real GGUF expert-0 validation --------------------------------
+    if not args.no_gguf:
+        print(f"\n=== Real GGUF expert-0 Q2_K GEMM  (gguf={args.gguf}) ===")
+        res = _validate_gguf(args.gguf, m=8, device=device)
+        if res is None:
+            print("  [skip] GGUF not found or no Q2_K expert tensor")
+        else:
+            print(f"  shape M=8 N={res['n']} K={res['k']}")
+            print(f"  ref |C|_max            : {res['ref_abs_max']:.4f}")
+            print(f"  max abs diff          : {res['max_abs']:.3e}")
+            print(f"  worst_rel (prod gate) : {res['worst_rel']:.3e}")
+            print(f"  rel L2      (vs fp32) : {res['rel_l2']:.3e}")
+            print(f"  worst_rel vs bf16-GPU : {res['worst_rel_vs_bf16gpu']:.3e}")
+            print(f"  rel L2      vs bf16   : {res['rel_l2_vs_bf16gpu']:.3e}")
+            print(f"  max_rel_elem (vs fp32): {res['max_rel_elem']:.3e}")
+            print(f"  dequant max_abs/worst : {res['dequant_max_abs']:.3e} / "
+                  f"{res['dequant_worst_rel']:.3e}")
+            ok = (res["worst_rel"] < tol_rel) and np.isfinite(res["worst_rel"])
+            overall_pass = overall_pass and ok
+            print(f"  RESULT (gate {tol_rel:.0e})    : {'PASS' if ok else 'FAIL'} "
+                  f"on worst_rel")
+
+    # ----- Optional timing ----------------------------------------------
+    if args.bench and device.type == "cuda":
+        print(f"\n=== Timing (M=8 N={N} K={K}, bf16 tensor cores vs fused) ===")
+        w_bytes_np = _make_random_q2_k_weights(N, K, seed=args.seed)
+        w_bytes_t = torch.from_numpy(w_bytes_np.copy()).to(device)
+        rng = torch.Generator().manual_seed(args.seed + 17)
+        a_bf16 = (torch.randn(8, K, generator=rng) * 0.3).to(torch.bfloat16).to(device)
+        k_ms, t_ms, k_tf = _bench(a_bf16, w_bytes_t, (N, K), device)
+        print(f"  fused q2_k_mm    : {k_ms*1000:.1f} us  ({k_tf:.3f} TFLOPS-equiv)")
+        print(f"  torch.matmul bf16: {t_ms*1000:.1f} us")
+        print(f"  HBM read (fused) : {N*(K//256)*84/1e6:.2f} MB weights @ "
+              f"2.625 bits/elem  vs  {N*K*2/1e6:.1f} MB bf16")
+
+    print(f"\n=== OVERALL: {'PASS' if overall_pass else 'FAIL'} ===")
+    return 0 if overall_pass else 1
+
+
+# ===========================================================================
+# Q8_K-activation DP4A variant.
+#
+# Matches antirez's ``dev_dot_q2_K_q8_K_block`` (ds4_cuda.cu:17239) exactly:
+# int8 activations (Q8_K-quantized) DP4A int8 codes (pre-scaled by per-sub-block
+# 4-bit scale; codes 0..3 x scale 0..15 = 0..45, fits int8) -> int32 accumulate
+# -> fp32 fold with ``dall*isum - dmin*summs`` (the Q2_K d/min decomposition).
+#
+# This is the trajectory the IQ2_XXS/Q2_K quantization was calibrated against.
+# The bf16 variant above produces a slightly different result that diverges
+# from the calibration target; across 43 layers x long context this compounds
+# and degrades needle accuracy (the 16K-needle failure mode).
+#
+# Antirez's per-block math (dev_dot_q2_K_q8_K_block, ds4_cuda.cu:17239):
+#   summs = sum over 16 sub-blocks of (q8_K.bsums[is] * (scales[is] >> 4))  int32
+#   isum  = 0
+#   for k in 0,1:
+#     shift = 0
+#     for j in 0..3:
+#       scale = scales[is++] & 0x0f
+#       isum += scale * sum_{i in 16}(q8[i] * ((qs[i] >> shift) & 3))
+#       scale = scales[is++] & 0x0f
+#       isum += scale * sum_{i in 16}(q8[i+16] * ((qs[i+16] >> shift) & 3))
+#       shift += 2; q8 += 32
+#     qs += 32
+#   return dall*isum - dmin*summs   where dall = d_a*d_w, dmin = d_a*dmin_w
+#
+# Pair structure: pairs ip=0..7 cover 32 elements = sub-blocks (is0=2*ip,
+# is1=2*ip+1) at shift=(ip%4)*2.  We PRE-SCALE the codes by per-half scale
+# (scale0 for first 16, scale1 for last 16) -> int8 in [0, 45], then do ONE
+# K=32 DP4A dot per pair.  The min contribution uses the precomputed Q8_K
+# ``bsums`` (sums of 16 qs each) via a 3D-broadcast outer-product accumulation
+# (avoids the unsupported K=16 tl.dot).
+# ===========================================================================
+@triton.jit
+def _q2_k_mm_q8k_kernel(
+    a_qs_ptr,      # *int8 [M, K]  Q8_K-quantized activations
+    a_d_ptr,       # *fp32 [M, K // 256]  per-block Q8_K scales
+    a_bsums_ptr,   # *int16 [M, K // 16]  per-16-sub-block sums of qs
+    w_ptr,         # *uint8 [N, BLOCKS_PER_ROW * 84]
+    c_ptr,         # *bf16 [M, N]
+    M, N_RUNTIME,
+    stride_aqm, stride_aqk,
+    stride_adm,
+    stride_abm,    # stride (per-row) of a_bsums; inner stride is 1
+    stride_wn,
+    stride_cm, stride_cn,
+    BLOCKS_PER_ROW: tl.constexpr,
+    K: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+    BLOCK_BYTES: tl.constexpr,
+):
+    pid_n = tl.program_id(0)
+    pid_m = tl.program_id(1)
+
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
+    mask_m = offs_m < M
+    mask_n = offs_n < N_RUNTIME
+
+    i32 = tl.arange(0, 32)
+    is_half1 = i32 >= 16                                # [32] constexpr bool
+
+    acc_f32 = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+
+    for kb in range(BLOCKS_PER_ROW):
+        # ---- Q2_K block base + d (fp16) + dmin (fp16) ---------------------
+        block_base = offs_n * stride_wn + kb * BLOCK_BYTES         # [BLOCK_N]
+
+        d_lo = tl.load(w_ptr + block_base + 80, mask=mask_n, other=0).to(tl.uint32)
+        d_hi = tl.load(w_ptr + block_base + 81, mask=mask_n, other=0).to(tl.uint32)
+        d_fp32 = ((d_lo | (d_hi << 8)).to(tl.uint16)).to(tl.float16, bitcast=True).to(tl.float32)
+        dm_lo = tl.load(w_ptr + block_base + 82, mask=mask_n, other=0).to(tl.uint32)
+        dm_hi = tl.load(w_ptr + block_base + 83, mask=mask_n, other=0).to(tl.uint32)
+        dmin_fp32 = ((dm_lo | (dm_hi << 8)).to(tl.uint16)).to(tl.float16, bitcast=True).to(tl.float32)
+
+        # ---- per-M-row Q8_K scale for this kb ----------------------------
+        a_d = tl.load(a_d_ptr + offs_m * stride_adm + kb, mask=mask_m, other=0.0)  # [BLOCK_M]
+
+        # ---- D-part: 8 pairs, each -> K=32 DP4A dot ----------------------
+        isum = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.int32)
+
+        for ip in tl.static_range(8):
+            is0 = 2 * ip
+            is1 = 2 * ip + 1
+            k0 = is0 // 8                # 0 for ip<4, 1 for ip>=4
+            shift = (ip % 4) * 2         # 0,2,4,6,0,2,4,6
+
+            # Per-half scale (low nibble) -- load the 2 scale bytes directly.
+            s0_byte = tl.load(w_ptr + block_base + is0, mask=mask_n, other=0).to(tl.uint32)
+            s1_byte = tl.load(w_ptr + block_base + is1, mask=mask_n, other=0).to(tl.uint32)
+            scale0 = (s0_byte & 0xF).to(tl.int32)                    # [BLOCK_N]
+            scale1 = (s1_byte & 0xF).to(tl.int32)                    # [BLOCK_N]
+
+            # qs window: 32 bytes at offset 16 + k0*32 (both halves of this k-group)
+            qs_offs = 16 + k0 * 32 + i32                              # [32]
+            qs_window = tl.load(
+                w_ptr + block_base[:, None] + qs_offs[None, :],
+                mask=mask_n[:, None], other=0,
+            ).to(tl.uint32)                                          # [BLOCK_N, 32]
+            codes = ((qs_window >> shift) & 0x3).to(tl.int32)        # [BLOCK_N, 32] in 0..3
+
+            # Per-half scale vector: [BLOCK_N, 32], first 16 = scale0, last 16 = scale1.
+            scale_vec = tl.where(
+                is_half1[None, :], scale1[:, None], scale0[:, None]
+            )                                                        # [BLOCK_N, 32]
+
+            # Pre-scale codes (max 15*3=45, fits int8) and cast for DP4A.
+            prescaled = (scale_vec * codes).to(tl.int8)              # [BLOCK_N, 32]
+
+            # Load int8 activations for this pair's K-window.
+            k_glob = kb * 256 + ip * 32 + i32                        # [32]
+            a_tile = tl.load(
+                a_qs_ptr + offs_m[:, None] * stride_aqm + k_glob[None, :] * stride_aqk,
+                mask=mask_m[:, None], other=0,
+            ).to(tl.int8)                                            # [BLOCK_M, 32]
+
+            # DP4A int8 x int8 -> int32 (IMMA on sm_89).
+            sumi = tl.dot(a_tile, tl.trans(prescaled), out_dtype=tl.int32)  # [BLOCK_M, BLOCK_N]
+            isum += sumi
+
+        # ---- Min-part: summs[m,n] = sum over 16 sub-blocks of ------------
+        # ----          (a_bsums[m,is] * mins[n,is])               int32 ----
+        # (mins = high nibble of scales).  Load full scales[16] tile and
+        # a_bsums[16] per-M-row tile, then 3D-broadcast outer-product sum.
+        scales_tile = tl.load(
+            w_ptr + block_base[:, None] + tl.arange(0, 16)[None, :],
+            mask=mask_n[:, None], other=0,
+        ).to(tl.uint32)                                              # [BLOCK_N, 16]
+        mins_tile = (scales_tile >> 4).to(tl.int32)                  # [BLOCK_N, 16]
+
+        bsums_tile = tl.load(
+            a_bsums_ptr + offs_m[:, None] * stride_abm + (kb * 16 + tl.arange(0, 16))[None, :],
+            mask=mask_m[:, None], other=0,
+        ).to(tl.int32)                                              # [BLOCK_M, 16]
+
+        # 3D broadcast outer-product accumulation (validated: bit-exact).
+        summs_3d = bsums_tile[:, None, :] * mins_tile[None, :, :]    # [BLOCK_M, BLOCK_N, 16]
+        summs = tl.sum(summs_3d, axis=2)                             # [BLOCK_M, BLOCK_N]
+
+        # ---- Float fold: dall*isum - dmin*summs (per-kb) -----------------
+        dall = a_d[:, None] * d_fp32[None, :]                        # [BLOCK_M, BLOCK_N]
+        dmin_arr = a_d[:, None] * dmin_fp32[None, :]                 # [BLOCK_M, BLOCK_N]
+        acc_f32 += dall * isum.to(tl.float32) - dmin_arr * summs.to(tl.float32)
+
+    tl.store(
+        c_ptr + offs_m[:, None] * stride_cm + offs_n[None, :] * stride_cn,
+        acc_f32.to(tl.bfloat16),
+        mask=mask_m[:, None] & mask_n[None, :],
+    )
+
+
+def q2_k_mm_q8k(
+    a_qs: torch.Tensor,
+    a_d: torch.Tensor,
+    a_bsums: torch.Tensor,
+    w_q2k_bytes: torch.Tensor,
+    w_shape: Tuple[int, int],
+    *,
+    block_m: int = 16,
+    block_n: int = 16,
+    num_warps: int = 2,
+) -> torch.Tensor:
+    """Fused Q2_K GEMM with Q8_K activations (matches antirez DP4A math).
+
+    Computes the Q2_K x Q8_K dot product using int8 codes (pre-scaled by the
+    per-sub-block 4-bit scale) DP4A'd against Q8_K-quantized int8 activations,
+    with the min contribution folded in via the precomputed Q8_K ``bsums``.
+
+    Args:
+        a_qs: int8 ``[M, K]`` Q8_K-quantized activations.
+        a_d: fp32 ``[M, K // 256]`` per-256-block Q8_K scales.
+        a_bsums: int16 ``[M, K // 16]`` per-16-sub-block sums of qs.
+        w_q2k_bytes: uint8 raw Q2_K blocks (same layout as ``q2_k_mm``).
+        w_shape: ``(N, K)``. K must be a multiple of 256.
+
+    Returns:
+        bf16 ``[M, N]`` on the same device as ``a_qs``.
+    """
+    if a_qs.dtype != torch.int8:
+        raise TypeError(f"a_qs must be int8, got {a_qs.dtype}")
+    if a_d.dtype != torch.float32:
+        raise TypeError(f"a_d must be fp32, got {a_d.dtype}")
+    if a_bsums.dtype != torch.int16:
+        raise TypeError(f"a_bsums must be int16, got {a_bsums.dtype}")
+    if w_q2k_bytes.dtype != torch.uint8:
+        raise TypeError(f"W bytes must be uint8, got {w_q2k_bytes.dtype}")
+    M, K_a = a_qs.shape
+    N, K = w_shape
+    if K != K_a:
+        raise ValueError(f"K mismatch: a_qs has K={K_a}, w_shape has K={K}")
+    if K % QK_K != 0:
+        raise ValueError(f"K={K} must be a multiple of {QK_K}")
+    if a_d.shape != (M, K // QK_K):
+        raise ValueError(f"a_d shape {a_d.shape} != ({M}, {K // QK_K})")
+    if a_bsums.shape != (M, K // 16):
+        raise ValueError(f"a_bsums shape {a_bsums.shape} != ({M}, {K // 16})")
+    blocks_per_row = K // QK_K
+    row_bytes = blocks_per_row * Q2_K_BLOCK_BYTES
+
+    device = a_qs.device
+    a_qs = a_qs.contiguous()
+    w = w_q2k_bytes.reshape(-1).contiguous().to(device)
+    if w.numel() != N * row_bytes:
+        raise ValueError(
+            f"W bytes: have {w.numel()}, expected {N * row_bytes}"
+        )
+    w = w.reshape(N, row_bytes)
+    a_d = a_d.contiguous().to(device)
+    a_bsums = a_bsums.contiguous().to(device)
+
+    c = torch.empty((M, N), dtype=torch.bfloat16, device=device)
+    grid_dim = (triton.cdiv(N, block_n), triton.cdiv(M, block_m))
+    _q2_k_mm_q8k_kernel[grid_dim](
+        a_qs, a_d, a_bsums, w, c,
+        M, N,
+        a_qs.stride(0), a_qs.stride(1),
+        a_d.stride(0),
+        a_bsums.stride(0),
+        w.stride(0),
+        c.stride(0), c.stride(1),
+        BLOCKS_PER_ROW=blocks_per_row,
+        K=K,
+        BLOCK_M=block_m,
+        BLOCK_N=block_n,
+        BLOCK_BYTES=Q2_K_BLOCK_BYTES,
+        num_warps=num_warps,
+    )
+    return c
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
