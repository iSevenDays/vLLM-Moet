+# rather than fail: an unrunnable Blackwell-only path reported as 6 red tests
+# hides real regressions in the paths sm_89 DOES use.
+_REQUIRES_MXFP4_INDEXER = pytest.mark.skipif(
+    not current_platform.is_device_capability_family(100),
+    reason="MXFP4 indexer cache requires datacenter Blackwell (sm_10x); "
+    "the kernel does not lower on this device",
